# ==============================================================================
# PrismEra (棱镜纪) 环境变量配置模板
# 复制为 .env 并在需要时填入真实密钥，或使用内置系统控制台在网页端热配置
# ==============================================================================

# LLM 推理渠道选择: auto | mock | openai | deepseek | claude | ollama
# auto: 自动探测可用环境变量，若无任何 Key 则自动使用 Deterministic 离线模拟引擎
# mock: 强制离线 100% 确定性运行（零网络依赖，评测与自测保障）
LLM_PROVIDER=auto

# 生成参数
TEMPERATURE=0.2

# 数据持久化目录（为空则使用项目默认 prismera/data）
PRISMERA_DATA_DIR=

# ------------------------------------------------------------------------------
# 渠道 A: OpenAI 或通用 OpenAI-Compatible API (如 vLLM, 各种中转网关, 智谱, Moonshot)
# ------------------------------------------------------------------------------
OPENAI_API_KEY=
OPENAI_API_BASE=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o

# ------------------------------------------------------------------------------
# 渠道 B: DeepSeek 官方直连 API
# ------------------------------------------------------------------------------
DEEPSEEK_API_KEY=
DEEPSEEK_API_BASE=https://api.deepseek.com/v1
DEEPSEEK_MODEL=deepseek-chat

# ------------------------------------------------------------------------------
# 渠道 C: Anthropic Claude 官方 API
# ------------------------------------------------------------------------------
ANTHROPIC_API_KEY=
ANTHROPIC_BASE_URL=https://api.anthropic.com
ANTHROPIC_MODEL=claude-3-5-sonnet-20241022

# ------------------------------------------------------------------------------
# 渠道 D: 本地私有化 Ollama / vLLM (无需 API Key)
# ------------------------------------------------------------------------------
OLLAMA_API_BASE=http://localhost:11434/v1
OLLAMA_MODEL=llama3

# 渠道 D2: PrismEra 自训练 LoRA 微调权重服务 (vLLM / HuggingFace Local / TGI)
LORA_API_BASE=http://localhost:8000/v1
LORA_MODEL=qwen2.5-7b-prismera-lora

# ------------------------------------------------------------------------------
# 渠道 E: 可选企业级 Neo4j 图数据库连接（默认使用 NetworkX + SQLite 无缝单机持久化）
# ------------------------------------------------------------------------------
NEO4J_URI=bolt://localhost:7687
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=password
